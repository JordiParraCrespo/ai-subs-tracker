<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the hardened runtime lets ResetOwl do, for signing with a Developer ID
  and notarizing (electron-builder.json, mac.entitlements). V8's JIT is the
  one exception Electron needs. There is no App Sandbox: the collector reads
  ~/.claude and ~/.codex and runs the `claude` and `codex` CLIs, which a
  sandboxed app could not.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
