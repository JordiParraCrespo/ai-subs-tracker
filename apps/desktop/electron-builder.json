{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.resetowl.desktop",
  "productName": "ResetOwl",
  "copyright": "ResetOwl",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "!dist/**/*.map", "package.json"],
  "extraResources": [
    {
      "from": "../web/dist",
      "to": "renderer",
      "filter": ["**/*"]
    }
  ],
  "npmRebuild": false,
  "artifactName": "ResetOwl-${version}-${os}-${arch}.${ext}",
  "icon": "dist/assets/icon.png",
  "mac": {
    "icon": "dist/assets/icon-mac.png",
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip"]
  },
  "win": {
    "executableName": "ResetOwl",
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "shortcutName": "ResetOwl",
    "uninstallDisplayName": "ResetOwl"
  },
  "linux": {
    "icon": "dist/assets/icons",
    "category": "Development",
    "target": ["AppImage"],
    "executableName": "resetowl",
    "syncDesktopName": true,
    "synopsis": "Use up the Claude Code and Codex subscriptions you pay for",
    "description": "Tracks what each Claude Code and Codex plan has left and which account to use next.",
    "desktop": {
      "entry": {
        "GenericName": "Subscription usage tracker",
        "Keywords": "claude;codex;usage;limits;subscription;"
      }
    }
  },
  "publish": null
}
