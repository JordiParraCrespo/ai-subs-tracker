---
import DownloadPage from '@/components/download/DownloadPage.astro';
import { siteConfig } from '@/config/site';

export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}
---

<DownloadPage />
