---
/** Privacy and terms: a narrow reading column under the "last updated" line. */
import type { CollectionEntry } from 'astro:content';

import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { useTranslations } from '@/i18n';
import { breadcrumbListSchema, webPageSchema } from '@/lib/jsonld';
import { currentLocale, localePath } from '@/lib/locale';

import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'legal'>;
}

const { entry } = Astro.props;
const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
const url = localePath(locale, `/legal/${entry.id.split('/').slice(1).join('/')}/`);
const crumbs = [
  { name: t('nav.home'), url: localePath(locale, '/') },
  { name: entry.data.title, url },
];
const schemas = [
  breadcrumbListSchema(crumbs),
  webPageSchema({
    url,
    title: entry.data.title,
    description: entry.data.description,
    inLanguage: locale,
    dateModified: entry.data.lastUpdated,
  }),
];
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' }).format(
  entry.data.lastUpdated,
);
---

<BaseLayout title={entry.data.title} description={entry.data.description} schemas={schemas}>
  <article class="ds-container site-guide__body site-legal">
    <Breadcrumbs crumbs={crumbs} label={t('guide.breadcrumbs')} />
    <h1 class="site-guide__title">{entry.data.title}</h1>
    <p class="site-note">
      {t('legal.lastUpdated')}: <time datetime={entry.data.lastUpdated.toISOString()}>{date}</time>
      · {t('legal.version')} {entry.data.version}
    </p>
    <div class="site-prose"><slot /></div>
  </article>
</BaseLayout>
