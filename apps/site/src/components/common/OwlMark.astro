---
/**
 * ResetOwl's mark: a white owl on the brand tile, the same shape the desktop
 * app draws for its icon (apps/desktop/scripts/build.mjs). Decorative next to
 * the name, so it is hidden from assistive tech.
 */
interface Props {
  size?: number;
}

const { size = 24 } = Astro.props;
---

<svg
  class="site-owl"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="7" fill="var(--ds-brand)"></rect>
  <g fill="#fff">
    <polygon points="7.76,5.65 13.89,10.19 7.55,12.83"></polygon>
    <polygon points="24.24,5.65 18.11,10.19 24.45,12.83"></polygon>
    <ellipse cx="16" cy="17.27" rx="8.45" ry="8.87"></ellipse>
  </g>
  <g fill="var(--ds-brand)">
    <circle cx="12.41" cy="15.16" r="3.17"></circle>
    <circle cx="19.59" cy="15.16" r="3.17"></circle>
    <polygon points="14.84,17.48 17.16,17.48 16,19.8"></polygon>
  </g>
  <g fill="#fff">
    <circle cx="12.41" cy="15.16" r="1.27"></circle>
    <circle cx="19.59" cy="15.16" r="1.27"></circle>
  </g>
</svg>
