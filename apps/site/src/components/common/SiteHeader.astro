---
import { links } from '@/config/site';
import { useTranslations } from '@/i18n';
import { currentLocale, localePath } from '@/lib/locale';
import { headerNav } from '@/lib/nav';

import ButtonLink from './ButtonLink.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';
import OwlMark from './OwlMark.astro';
import ThemeToggle from './ThemeToggle.astro';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = localePath(locale, '/');

const nav = headerNav(locale);
---

<header class="site-header">
  <div class="ds-container site-header__bar">
    <a href={home} class="site-brand"><OwlMark />ResetOwl</a>
    <nav class="site-nav" aria-label={t('nav.sections')}>
      {nav.map((item) => <a href={item.href} class="site-link">{t(item.key)}</a>)}
    </nav>
    <div class="site-header__actions">
      <LocaleSwitcher />
      <ThemeToggle />
      <ButtonLink href={links.signIn} variant="ghost" size="sm" class="site-header__signin">
        {t('nav.signIn')}
      </ButtonLink>
      <ButtonLink href={links.download} variant="primary" size="sm">{t('nav.download')}</ButtonLink>
    </div>
  </div>
</header>
