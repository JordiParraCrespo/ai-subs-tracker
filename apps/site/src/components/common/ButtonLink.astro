---
/** The design system's button (`.ds-btn`) on a link: every call to action here navigates. */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
}

const { variant = 'secondary', size = 'md', class: className, ...rest } = Astro.props;
---

<a
  class:list={['ds-btn', `ds-btn--${size}`, variant !== 'secondary' && `ds-btn--${variant}`, className]}
  {...rest}
>
  <slot name="icon" />
  <slot />
</a>
