---
import { ArrowRight } from '@lucide/astro';

import { useTranslations } from '@/i18n';
import { currentLocale, localePath } from '@/lib/locale';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="ds-container site-cta">
  <div class="site-band">
    <div class="site-band__text">
      <h2 class="site-band__title">{t('cta.title')}</h2>
      <span class="site-band__lede">{t('cta.lede')}</span>
    </div>
    <a href={localePath(locale, '/download/')} class="site-band__cta">
      {t('cta.button')}
      <ArrowRight size={16} aria-hidden="true" />
    </a>
  </div>
</section>
