---
import { ArrowRight } from '@lucide/astro';

import { links } from '@/config/site';
import { useTranslations } from '@/i18n';
import { currentLocale } from '@/lib/locale';

const t = useTranslations(currentLocale(Astro.currentLocale));
---

<section class="ds-container site-cta">
  <div class="site-band">
    <div class="site-band__text">
      <h2 class="site-band__title">{t('cta.title')}</h2>
      <span class="site-band__lede">{t('cta.lede')}</span>
    </div>
    <a href={links.download} class="site-band__cta">
      {t('cta.button')}
      <ArrowRight size={16} aria-hidden="true" />
    </a>
  </div>
</section>
