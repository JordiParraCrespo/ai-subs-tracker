---
/** The design system's entity mark (`.ds-avatar--token`): initials on a colour. */
interface Props {
  initials: string;
  color: string;
  size?: number;
}

const { initials, color, size = 32 } = Astro.props;
// Size and colour are the caller's data, hence the style attribute.
const style = `width:${size}px;height:${size}px;background:${color};${size <= 32 ? `font-size:${Math.round(size * 0.42)}px` : ''}`;
---

<span class="ds-avatar ds-avatar--token" style={style} aria-hidden="true">{initials}</span>
