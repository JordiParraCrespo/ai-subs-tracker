{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/charts/**",
              "components/data/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/selection/**",
              "components/surfaces/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree))/i]",
        "message": "Font not provided by the design system. Available: Figtree."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountUnit'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|initials|color|src|key|ref|className|style|children)$/]",
        "message": "<AmountUnit> doesn't accept that prop. Declared props: label, initials, color, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|labels|height|title|formatValue|prefix|suffix|restLabel|ranges|range|defaultRange|onRangeChange|status|tone|className|style|key|ref|className|style|children)$/]",
        "message": "<AreaChart> doesn't accept that prop. Declared props: data, labels, height, title, formatValue, prefix, suffix, restLabel, ranges, range, defaultRange, onRangeChange, status, tone, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaChart'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<AreaChart> tone must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|size|src|alt|initials|icon|color|badge|badgeColor|className|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: kind, size, src, alt, initials, icon, color, badge, badgeColor, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:contact|entity|category|tile|disc|account)$/]",
        "message": "<Avatar> kind must be one of 'contact' | 'entity' | 'category' | 'tile' | 'disc' | 'account'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, size, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:info|code|text)$/]",
        "message": "<Badge> variant must be one of 'info' | 'code' | 'text'."
