{
  "name": "ai-subs-tracker",
  "version": "0.1.0",
  "description": "One place to see how much of each AI coding subscription (Claude Code first) you have left.",
  "type": "module",
  "bin": {
    "aisubs": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/test/**/*.test.js\"",
    "start": "node dist/cli.js",
    "dev": "npm run build && node dist/cli.js serve --open"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "private": true
}
